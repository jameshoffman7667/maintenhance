# deploy/.env.example - every variable the stack reads, names only. Copy to the
# stack's .env on the server; never commit real values.
# Required: PORT_HOST (from the port register), JWT_SECRET (openssl rand -hex 32).
# FAST_STORAGE / SLOW_STORAGE are optional path prefixes (defaults are in compose.yaml).
PORT_HOST=
JWT_SECRET=
APP_URL=
COOKIE_SECURE=
FAST_STORAGE=
SLOW_STORAGE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_WARRANTY_WINDOW_DAYS=
NOTIFY_UNREVIEWED_WINDOW_DAYS=
BACKUP_KEEP=
BACKUP_SNAPSHOTS=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=
AI_MAX_CONCURRENCY=
PUSH_ENABLED=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_ADDRESS=
TRUST_PROXY=
