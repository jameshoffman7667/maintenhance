# Variables read by deploy/compose.yaml. Names and safe defaults only; real
# values live in the server stack's .env, never in the repo.

# Host port = container port. maintenhance is assigned 8040 in the port register.
PORT_HOST=8040

# Storage roots (one folder per app is created under each, named maintenhance).
# FAST_STORAGE holds the SQLite database (/data); SLOW_STORAGE holds photos,
# nightly snapshots and temp files (/files). Leave unset to use the defaults in compose.yaml.
FAST_STORAGE=
SLOW_STORAGE=

# REQUIRED secret that signs login sessions. Generate with: openssl rand -hex 32
# Changing it signs everyone out. Never commit a real value.
JWT_SECRET=

# Public address people use to open the app, no trailing slash. Needed for the
# emailed password-reset link.
APP_URL=
# "true" when served over HTTPS (Cloudflare), which is the case on the server.
COOKIE_SECURE=true

# Optional email digest and password reset. Leave SMTP_HOST blank to disable.
# Server values: mail.smtp2go.com, port 587, STARTTLS, sender server@hoffmanhouse.ca.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_WARRANTY_WINDOW_DAYS=30
NOTIFY_UNREVIEWED_WINDOW_DAYS=3

# Nightly database snapshots in /data: how many to keep, or false to turn off.
BACKUP_KEEP=7
BACKUP_SNAPSHOTS=true

# Optional AI features (fill in from a link, Build with AI). Blank disables them.
GEMINI_API_KEY=
GEMINI_MODEL=
