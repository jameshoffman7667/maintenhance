# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# your own values before running `docker compose up`.

# Port the app is served on, both inside the container and on the host.
# Change this if 8040 is already in use on your machine.
PORT=8040

# ---- Storage (optional) ----
# DATA_PATH holds the database - keep it on fast storage (SSD).
# FILES_PATH holds photos, nightly snapshots and temp files - fine on a
# slower disc pool. Each may be a host folder path (e.g. /mnt/ssd/maintenhance
# and /mnt/pool/maintenhance) or left blank to use a Docker named volume.
# Folders must exist and be writable by the container (it runs as root).
DATA_PATH=
FILES_PATH=

# A long, random, secret string used to sign login sessions.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Leave "false" for local/LAN access over plain HTTP.
# Set to "true" only once the app is served over HTTPS (e.g. via a
# reverse proxy you run in front of it — see README.md) — otherwise
# your browser will silently refuse to send the login cookie and
# you'll get logged out immediately after signing in.
COOKIE_SECURE=false

# ---- Email notifications (optional) ----
# Leave SMTP_HOST unset/blank to disable notifications entirely — nothing
# is sent and no error is raised. Set it to turn on a once-a-day digest
# email covering: overdue work orders, warranties expiring soon, and work
# requests that have sat unreviewed too long. Each household member picks
# which of those three they want in Owner Tools (needs their email set
# there too) — a blank email or all three toggles off means no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the "From" address. Defaults to maintenhance@<SMTP_HOST> if unset.
SMTP_FROM=

# How many days out a warranty counts as "expiring soon" (default 30),
# and how many days an unreviewed work request has to sit before it's
# flagged (default 3). Both optional.
NOTIFY_WARRANTY_WINDOW_DAYS=30
NOTIFY_UNREVIEWED_WINDOW_DAYS=3

# ---- Password reset by email (optional) ----
# The public address people use to open the app, without a trailing
# slash (e.g. https://maint.example.com). Together with SMTP_HOST above
# it turns on "Forgot password?" on the sign-in screen: the reset link
# is sent to the email address stored on the user's account.
APP_URL=

# ---- Automatic database snapshots ----
# A consistent copy of the database is saved to the data volume about
# once a day. BACKUP_KEEP = how many to keep; BACKUP_SNAPSHOTS=false
# turns them off. Keep your own off-device copy too (Owner Tools ->
# Full backup).
BACKUP_KEEP=7
BACKUP_SNAPSHOTS=true

# Branding, logo, colours, location labels and feature toggles (such as
# Home Assistant alarms) are now managed in the app by the Owner:
# Owner Tools -> Branding & terminology / Features.

# ---- Fill in from a link: optional AI step ----
# Without a key, "Fill in from a link" on asset/vendor/part forms reads the
# page's own product details. With a key, the Owner can also switch on AI
# refinement in Owner Tools -> Features: the link and the page's visible text
# are then sent to Google's Gemini service. The key stays on the server.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash).
GEMINI_MODEL=

# Time zone for digest email send times, e.g. America/Toronto (default UTC).
TZ=
